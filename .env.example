# 프로토콜(bolt://)을 반드시 포함하여 작성 (예: bolt://localhost:7687)
NEO4J_URI=

# 데이터베이스 계정명 (예: neo4j)
NEO4J_USER=

# 데이터베이스 비밀번호 (필수 기입)
NEO4J_PASSWORD=

# 허용할 프론트엔드 URL (마지막에 '/' 생략 예: http://localhost:3000)
FRONTEND_URL=

# VLMService(Gemini) API 키
GEMINI_API_KEY=

# 두 내부 VLM 경로는 기본 비활성화. 활성화 전 TLS, 사설망/인그레스 제한과 법률 검토 필요
VLM_ENABLED=false

# 별도 비밀 관리 수단에서 주입할 32바이트 이상의 고엔트로피 내부 공유키
VLM_INTERNAL_SHARED_SECRET=

# 외부 AI 전송은 W03에서 승인되지 않았으므로 기본 비활성화
VLM_EXTERNAL_CALLS_ENABLED=false
VLM_PROVIDER=disabled
VLM_MODEL=gemini-3.8-flash
VLM_MAX_CONCURRENT=2
